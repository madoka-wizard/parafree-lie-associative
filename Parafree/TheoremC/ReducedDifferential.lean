import Parafree.TheoremC.PresentationComplex
import Parafree.Associative.CoinvariantsFree

/-! The presentation differential on coinvariants and its countably based
kernel. All formulas work over an arbitrary commutative coefficient ring. -/
noncomputable section
namespace Parafree.TheoremC.ReducedDifferential
open Parafree.Associative PresentationComplex
variable (k : Type*) [CommRing k]

abbrev V₁ := Fin 6 →₀ k
abbrev V₂ := ℕ →₀ k

def constantVector : V₁ k :=
  Finsupp.single 0 1 + Finsupp.single 2 1 - Finsupp.single 3 1 - Finsupp.single 5 1
def slopeVector : V₁ k := Finsupp.single 1 1 - Finsupp.single 4 1
def linearRelator (n : ℕ) : V₁ k := constantVector k + (n : k) • slopeVector k
def differential : V₂ k →ₗ[k] V₁ k := Finsupp.linearCombination k (linearRelator k)

def linearD : Free k →ₗ[k] V₁ k :=
  (CoinvariantsFree.reduce (augmentation k) (Fin 6)).comp (D k)

@[simp] theorem linearD_one : linearD k 1 = 0 := by simp [linearD]
@[simp] theorem linearD_letter (i : Fin 6) : linearD k (letter k i) = Finsupp.single i 1 := by
  simp [linearD]

theorem linearD_mul (a b : Free k) : linearD k (a*b) =
    freeAugmentation k a • linearD k b + freeAugmentation k b • linearD k a := by
  simp only [linearD, LinearMap.comp_apply, D_mul, map_add, map_smul,
    CoinvariantsFree.reduce_smul, augmentation_toFull]

theorem linearD_pow (i : Fin 6) (n : ℕ) :
    linearD k ((1+letter k i)^n) = (n : k) • Finsupp.single i 1 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, linearD_mul, ih]
    simp only [map_pow, map_add, map_one, freeAugmentation_letter, add_zero,
      one_pow, one_smul, linearD_one, linearD_letter, zero_add, Nat.cast_add, Nat.cast_one]
    module

theorem linearD_relator (n : ℕ) : linearD k (relator k n) = linearRelator k n := by
  simp only [relator, map_sub, linearD_mul, linearD_pow,
    map_mul, map_pow, map_add, map_one, freeAugmentation_letter, add_zero,
    one_pow, mul_one, one_smul, linearD_one, linearD_letter, zero_add]
  unfold linearRelator constantVector slopeVector
  module

theorem reduce_d₂ (v : P₂ k) : CoinvariantsFree.reduce (augmentation k) (Fin 6) (d₂ k v) =
    differential k (CoinvariantsFree.reduce (augmentation k) ℕ v) := by
  induction v using Finsupp.induction_linear with
  | zero => simp
  | add v w hv hw => simp only [map_add, hv, hw]
  | single n a =>
    simp only [d₂, Finsupp.linearCombination_single, CoinvariantsFree.reduce_smul,
      CoinvariantsFree.reduce_single, differential, Finsupp.linearCombination_single]
    rw [show CoinvariantsFree.reduce (augmentation k) (Fin 6) (D k (relator k n)) =
      linearRelator k n from linearD_relator k n]

def tail : V₂ k →ₗ[k] V₂ k :=
  Finsupp.lcomapDomain (fun n : ℕ => n+2) (fun _ _ h => Nat.add_right_cancel h)

@[simp] theorem tail_apply (v : V₂ k) (n : ℕ) : tail k v n = v (n+2) := rfl

/-- Correct the two linear moments of the n+2-th relation. -/
def cycle (n : ℕ) : V₂ k :=
  Finsupp.single (n+2) 1 + (n+1 : k) • Finsupp.single 0 1 -
    (n+2 : k) • Finsupp.single 1 1

def sectionMap : V₂ k →ₗ[k] V₂ k := Finsupp.linearCombination k (cycle k)

theorem cycle_closed (n : ℕ) : differential k (cycle k n) = 0 := by
  simp only [cycle, map_add, map_sub, map_smul, differential,
    Finsupp.linearCombination_single, one_smul, linearRelator, Nat.cast_add,
    Nat.cast_ofNat]
  module

theorem tail_cycle (n : ℕ) : tail k (cycle k n) = Finsupp.single n 1 := by
  classical
  ext m
  simp [cycle, Finsupp.single_apply, show m+2 ≠ 1 by omega]

theorem section_closed (v : V₂ k) : differential k (sectionMap k v) = 0 := by
  induction v using Finsupp.induction_linear with
  | zero => simp
  | add v w hv hw => simp [hv,hw]
  | single n a => simp [sectionMap, cycle_closed]

theorem tail_section (v : V₂ k) : tail k (sectionMap k v) = v := by
  induction v using Finsupp.induction_linear with
  | zero => simp
  | add v w hv hw => simp [hv,hw]
  | single n a => simp [sectionMap, tail_cycle]

theorem eq_zero_of_closed_tail {v : V₂ k}
    (hc : differential k v = 0) (ht : tail k v = 0) : v = 0 := by
  have he : v = Finsupp.single 0 (v 0) + Finsupp.single 1 (v 1) := by
    ext n
    obtain (_ | _ | n) := n
    · simp
    · simp
    · have hh := congrArg (fun x : V₂ k => x n) ht
      simpa using hh
  have hc1 := congrArg (fun x : V₁ k => x 1) hc
  have hc0 := congrArg (fun x : V₁ k => x 0) hc
  rw [he] at hc1 hc0
  have h1 : v 1 = 0 := by
    simpa [differential,linearRelator,constantVector,slopeVector] using hc1
  have h0 : v 0 = 0 := by
    simpa [differential,linearRelator,constantVector,slopeVector,h1] using hc0
  rw [he,h0,h1]
  simp

/-- The kernel is freely and countably generated by the corrected higher relators. -/
def kernelEquiv : LinearMap.ker (differential k) ≃ₗ[k] V₂ k :=
  LinearEquiv.ofBijective ((tail k).comp (LinearMap.ker (differential k)).subtype) (by
    constructor
    · intro v w h
      apply Subtype.ext
      apply sub_eq_zero.mp
      apply eq_zero_of_closed_tail k
      · rw [map_sub, v.property, w.property, sub_self]
      · rw [map_sub]
        exact sub_eq_zero.mpr h
    · intro v
      exact ⟨⟨sectionMap k v,section_closed k v⟩,tail_section k v⟩)

end Parafree.TheoremC.ReducedDifferential

import Parafree.TheoremA.PresentationTorsion
import Parafree.TheoremA.AuxiliaryPresentation
import Parafree.Lie.FreeScalarExtension

/-! The faithful rational realization with the original, undilated generators.
This identifies the actual residual quotient with the algebra generated by
ambient generators and the halves of the auxiliary relations. -/

noncomputable section
namespace Parafree.TheoremA.RationalModel

open Parafree.Lie

abbrev Ambient := FreeLieAlgebra ℚ (Fin 3)

def integralInclusion : Auxiliary.Free ℤ →ₗ⁅ℤ⁆ Ambient :=
  FreeScalarExtension.generatorMap ℚ (Fin 3)

theorem integralInclusion_injective : Function.Injective integralInclusion :=
  FreeScalarExtension.generatorMap_injective ℚ (Fin 3)

def x (i : Fin 3) : Ambient := FreeLieAlgebra.of ℚ i

def q (i : Fin 3) : Ambient := (1 / 2 : ℚ) • integralInclusion (Auxiliary.relator ℤ i)

theorem two_smul_q (i : Fin 3) : (2 : ℕ) • q i = integralInclusion (Auxiliary.relator ℤ i) := by
  rw [q, two_smul, ← add_smul]
  norm_num

theorem equations : equationStep q x = x := by
  funext i
  fin_cases i <;>
    simp [equationStep, two_smul_q, Auxiliary.relator, Auxiliary.generator,
      integralInclusion, LieHom.map_lie, x]

def evaluation : K →ₗ⁅ℤ⁆ Ambient := K.lift q x equations

@[simp] theorem evaluation_x (i : Fin 3) : evaluation (K.x i) = x i := K.lift_x _ _ _ i
@[simp] theorem evaluation_q (i : Fin 3) : evaluation (K.q i) = q i := K.lift_q _ _ _ i

theorem two_smul_injective : Function.Injective (fun a : Ambient => (2 : ℤ) • a) :=
  ScalarExtension.int_two_smul_injective ℚ (1 / 2) (by norm_num) Ambient

/-- Dilation relates this realization to the already checked integral model. -/
def dilation : Ambient →ₗ⁅ℤ⁆ Ambient :=
  { (FreeLieAlgebra.lift ℚ (fun i : Fin 3 => (2 : ℚ) • x i)).toLinearMap.restrictScalars ℤ with
    map_lie' := (FreeLieAlgebra.lift ℚ (fun i : Fin 3 => (2 : ℚ) • x i)).map_lie _ _ }

theorem dilation_evaluation : dilation.comp evaluation =
    integralInclusion.comp integralEvaluation := by
  apply K.hom_ext_of_two_smul_injective two_smul_injective
  intro i
  change dilation (evaluation (K.x i)) = integralInclusion (integralEvaluation (K.x i))
  rw [evaluation_x, integralEvaluation_x, integralX, map_smul]
  change FreeLieAlgebra.lift ℚ (fun i : Fin 3 => (2 : ℚ) • x i)
      (FreeLieAlgebra.of ℚ i) = (2 : ℤ) • integralInclusion (FreeLieAlgebra.of ℤ i)
  rw [FreeLieAlgebra.lift_of_apply]
  simp only [integralInclusion, FreeScalarExtension.generatorMap_of, x, two_smul]

theorem evaluation_ker : evaluation.ker = residualIdeal ℤ K := by
  apply le_antisymm
  · intro a ha
    have hd := LieHom.congr_fun dilation_evaluation a
    change dilation (evaluation a) = integralInclusion (integralEvaluation a) at hd
    have he : evaluation a = 0 := ha
    rw [he, map_zero] at hd
    have hz : integralEvaluation a = 0 := integralInclusion_injective (by
      rw [map_zero]
      exact hd.symm)
    rw [← integralEvaluation_ker]
    exact hz
  · exact K.residual_le_ker evaluation two_smul_injective

/-- The map is from the exact residual quotient used throughout Theorem A. -/
def realization : L →ₗ⁅ℤ⁆ Ambient :=
  quotientLift _ evaluation (by rw [evaluation_ker])

@[simp] theorem realization_toL (a : K) : realization (toL a) = evaluation a := rfl

theorem realization_injective : Function.Injective realization := by
  intro a b h
  obtain ⟨a, rfl⟩ := quotientMk_surjective (residualIdeal ℤ K) a
  obtain ⟨b, rfl⟩ := quotientMk_surjective (residualIdeal ℤ K) b
  apply sub_eq_zero.mp
  rw [← map_sub, quotientMk_eq_zero, ← evaluation_ker]
  change evaluation (a - b) = 0
  rw [map_sub]
  exact sub_eq_zero.mpr h

def equivRange : L ≃ₗ⁅ℤ⁆ realization.range :=
  realization.equivRangeOfInjective realization_injective

@[simp] theorem realization_x (i : Fin 3) : realization (toL (K.x i)) = x i := evaluation_x i
@[simp] theorem realization_q (i : Fin 3) : realization (toL (K.q i)) = q i := evaluation_q i

end Parafree.TheoremA.RationalModel

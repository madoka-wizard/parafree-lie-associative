import Parafree.TheoremA
import Parafree.TheoremB
import Parafree.TheoremC
import Parafree.TheoremD

/-!
# Main results

Compiled statements of the four main theorems in the manuscript
"The Parafree Conjecture for Lie rings and associative algebras". The proofs below use the public
endpoints in the corresponding `TheoremA`–`TheoremD` directories.

The Lie homology is the actual Chevalley–Eilenberg homology from LieRings.
Associative homology is the left derived coinvariant functor on the trivial
module, with its coefficient-ring module structure. Finite presentation has
the usual finite-generators, finite-relators meaning.
-/

noncomputable section
namespace Parafree.MainResults
open LieRings.Homological.LieHomology
open scoped TensorProduct

/-! ## Theorem A: a rank-three parafree Lie ring -/

section A
open TheoremA

/-- `L` is the residual quotient of the integral Lie ring on `q₁,q₂,q₃,z,u,v`
with relations `z = [u,v] + 2q₁`, `u = [v,z] + 2q₂`, `v = 2q₃ - [z,u]`.
The specified map `freeToL` sends the three free generators to the `qᵢ`.
The tensor factors here are in the manuscript's order. -/
example : Lie.IsParafree L 3 ∧ Lie.IsParaEquivalence freeToL ∧
    Nonempty ((Homology (R := ℤ) (L := L) 2 ⊗[ℤ] ZMod 2) ≃ₗ[ℤ] ZMod 2) :=
  ⟨theoremA.1, theoremA.2.1, ⟨homologyTwoTensorRightEquiv⟩⟩

/-- Reversing the tensor factors exposes the full field-linear equivalence. -/
example : (ZMod 2 ⊗[ℤ] Homology (R := ℤ) (L := L) 2) ≃ₗ[ZMod 2] ZMod 2 :=
  homologyTwoTensorEquiv

end A

/-! ## Theorem B: a finitely generated, infinitely related parafree Lie ring -/

section B
open TheoremB

/-- `P` is the integral Lie subring of the rational free Lie algebra on `t,a`
generated by `t,a,f₁/5,f₂/5`, with the literal right-nested relators from the
paper. The map `freeToP` sends the free generators to `t` and `a - 2(f₁/5)`;
`generatingMap` is the free Lie map on the four displayed generators. -/
example : Lie.IsParafree P 2 ∧ Lie.IsParaEquivalence freeToP ∧
    Nonempty ((Homology (R := ℤ) (L := P) 2 ⊗[ℤ] ZMod 5) ≃ₗ[ℤ] (ℕ →₀ ZMod 5)) ∧
    Function.Surjective generatingMap ∧ ¬ Lie.IsFinitelyPresented ℤ P :=
  ⟨theoremB.1, theoremB.2.1, ⟨homologyTwoTensorRightEquiv⟩,
    theoremB.2.2.2.1, theoremB.2.2.2.2⟩

/-- The countable direct sum is an isomorphism of vector spaces over `ZMod 5`. -/
example : (ZMod 5 ⊗[ℤ] Homology (R := ℤ) (L := P) 2) ≃ₗ[ZMod 5] (ℕ →₀ ZMod 5) :=
  homologyTwoTensorEquiv

end B

/-! ## Theorem C: the associative parafree algebra over a nonzero commutative ring -/

section C
open TheoremC Associative
variable (k : Type*) [CommRing k] [Nontrivial k]

/-- `A k` is the free algebra on `a,b,c,d,x,y` modulo all relations
`(1+a)(1+b)^n(1+c) = (1+d)(1+x)^n(1+y)` for natural `n`.
All six generators have augmentation zero. The specified para-equivalence
sends the four free generators to `a,b,c,d`; `toFull` exhibits finite generation.
Residual nilpotence together with this para-equivalence is parafreeness. -/
example : ResiduallyNilpotent (augmentation k) ∧
    (augmentedFourToFull k).IsParaEquivalence ∧
    Nonempty (homology k 2 ≃ₗ[k] (ℕ →₀ k)) ∧
    Function.Surjective (toFull k) ∧ ¬ IsFinitelyPresented k (A k) :=
  theoremC k

end C

/-! ## Theorem D: exact transfinite augmentation length -/

section D
open TheoremD
variable (k : Type*) [CommRing k] [Nontrivial k]

/-- For the algebra with only the first two relations from Theorem C, the
augmentation series becomes stationary for the first time at omega squared.
Its successor rule is `I^(α+1) = I^α I + I I^α`; limit stages are intersections.
Both stabilization and minimality are included. -/
example :
    ordinalPower k (Ordinal.omega0 * Ordinal.omega0) =
      ordinalPower k (Ordinal.omega0 * Ordinal.omega0 + 1) ∧
    ∀ α < Ordinal.omega0 * Ordinal.omega0,
      ordinalPower k α ≠ ordinalPower k (α + 1) :=
  theoremD k

end D
end Parafree.MainResults

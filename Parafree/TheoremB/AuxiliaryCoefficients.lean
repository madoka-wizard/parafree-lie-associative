import Parafree.TheoremB.AuxiliaryPresentation
import Mathlib.RingTheory.Ideal.Int

/-! The presentation comparison at the two coefficient rings used in Theorem B. -/
noncomputable section
namespace Parafree.TheoremB.Auxiliary

/-- The prime ideal generated by five; denominators outside this ideal are inverted. -/
def fiveIdeal : Ideal ℤ := Ideal.span {(5:ℤ)}
instance fiveIdeal_prime : fiveIdeal.IsPrime := by
  apply (Ideal.span_singleton_prime (by norm_num : (5:ℤ) ≠ 0)).mpr
  norm_num

abbrev AtFive := Localization.AtPrime fiveIdeal

theorem six_isUnit : IsUnit (6:AtFive) := by
  have h6 : (6:ℤ) ∈ fiveIdeal.primeCompl := by
    change (6:ℤ) ∉ fiveIdeal
    norm_num [fiveIdeal, Ideal.mem_span_singleton]
  simpa using IsLocalization.map_units AtFive (⟨6,h6⟩ : fiveIdeal.primeCompl)

def oneSixth : AtFive := six_isUnit.exists_right_inv.choose
@[simp] theorem six_oneSixth : (6:AtFive)*oneSixth = 1 := six_isUnit.exists_right_inv.choose_spec

def localizedEquiv : Presented AtFive ≃ₗ⁅AtFive⁆ G oneSixth := equivG oneSixth six_oneSixth
instance localizedPresented_free : Module.Free AtFive (Presented AtFive) :=
  presented_free oneSixth six_oneSixth

/-- In characteristic five, six is one and the second shift coefficient is one. -/
abbrev GmodFive := G (1 : ZMod 5)
def modFiveEquiv : Presented (ZMod 5) ≃ₗ⁅ZMod 5⁆ GmodFive :=
  equivG (1 : ZMod 5) (by decide)

@[simp] theorem localizedEquiv_gen (i : Fin 2) :
    localizedEquiv (gen AtFive i) =
      ![Parafree.Lie.PolynomialSolvable.Algebra.T AtFive (-9*oneSixth),a₀ oneSixth] i :=
  toG_gen oneSixth six_oneSixth i

@[simp] theorem modFiveEquiv_gen (i : Fin 2) :
    modFiveEquiv (gen (ZMod 5) i) =
      ![Parafree.Lie.PolynomialSolvable.Algebra.T (ZMod 5) (-9*1),a₀ (1:ZMod 5)] i :=
  toG_gen (1:ZMod 5) (by decide) i

end Parafree.TheoremB.Auxiliary
